# Backend API URL (Required for Production)
# If using Render, this is your backend's URL (e.g., https://your-app.onrender.com)
VITE_SERVER_URL=http://localhost:5000

# Cloudinary Cloud Name (Optional - if directly uploading from client, though we are doing server-side)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Push Notification VAPID Public Key (Must match server)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
